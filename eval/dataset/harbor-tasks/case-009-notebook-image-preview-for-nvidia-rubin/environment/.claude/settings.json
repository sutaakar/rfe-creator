{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /workspace/hooks/tools.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /workspace/hooks/tools.py"
          }
        ]
      },
      {
        "matcher": "mcp__atlassian__*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /workspace/hooks/tools.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Skill",
      "Agent",
      "Write(/tmp/rfe-assess/**)",
      "Write(/private/tmp/rfe-assess/**)",
      "Edit(/tmp/rfe-assess/**)",
      "Edit(/private/tmp/rfe-assess/**)"
    ]
  }
}
